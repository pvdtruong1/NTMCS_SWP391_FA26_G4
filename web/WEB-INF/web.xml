<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee
                             https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0">
    <session-config>
        <session-timeout>30</session-timeout>
    </session-config>

    <servlet>
        <servlet-name>PendingQueueServlet</servlet-name>
        <servlet-class>controller.editorial.PendingQueueServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>PendingQueueServlet</servlet-name>
        <url-pattern>/editorial/pending-queue</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>CriteriaScoringServlet</servlet-name>
        <servlet-class>controller.editorial.CriteriaScoringServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>CriteriaScoringServlet</servlet-name>
        <url-pattern>/editorial/criteria-scoring</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>IdeaArchiveServlet</servlet-name>
        <servlet-class>controller.editorial.IdeaArchiveServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>IdeaArchiveServlet</servlet-name>
        <url-pattern>/editorial/idea-archive</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>DirectiveTopicServlet</servlet-name>
        <servlet-class>controller.editorial.DirectiveTopicServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>DirectiveTopicServlet</servlet-name>
        <url-pattern>/editorial/directive-topic</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>DirectiveTopicServlet</servlet-name>
        <url-pattern>/editorial/directive-creation</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ReporterDispatchServlet</servlet-name>
        <servlet-class>controller.editorial.ReporterDispatchServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ReporterDispatchServlet</servlet-name>
        <url-pattern>/editorial/reporter-dispatch</url-pattern>
    </servlet-mapping>

    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>
</web-app>
