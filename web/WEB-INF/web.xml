<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee
                             https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0">
    <session-config>
        <session-timeout>30</session-timeout>
    </session-config>

    <!-- System & Auth Servlets -->
    <servlet>
        <servlet-name>LoginServlet</servlet-name>
        <servlet-class>controller.LoginServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LoginServlet</servlet-name>
        <url-pattern>/login</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>LogoutServlet</servlet-name>
        <servlet-class>controller.LogoutServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LogoutServlet</servlet-name>
        <url-pattern>/logout</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>HomeServlet</servlet-name>
        <servlet-class>controller.HomeServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>HomeServlet</servlet-name>
        <url-pattern>/home</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>DashboardServlet</servlet-name>
        <servlet-class>controller.DashboardServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>DashboardServlet</servlet-name>
        <url-pattern>/dashboard</url-pattern>
    </servlet-mapping>

    <!-- WF-01: Reporter Servlets -->
    <servlet>
        <servlet-name>ReporterServlet</servlet-name>
        <servlet-class>controller.ReporterServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ReporterServlet</servlet-name>
        <url-pattern>/reporter/*</url-pattern>
    </servlet-mapping>

    <!-- WF-02: Editorial Servlets -->
    <servlet>
        <servlet-name>EditorialDashboardServlet</servlet-name>
        <servlet-class>controller.editorial.EditorialDashboardServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>EditorialDashboardServlet</servlet-name>
        <url-pattern>/editorial/dashboard</url-pattern>
        <url-pattern>/editorial/editorial-dashboard</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>PendingQueueServlet</servlet-name>
        <servlet-class>controller.editorial.PendingQueueServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>PendingQueueServlet</servlet-name>
        <url-pattern>/editorial/pending-queue</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>CriteriaScoringServlet</servlet-name>
        <servlet-class>controller.editorial.CriteriaScoringServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>CriteriaScoringServlet</servlet-name>
        <url-pattern>/editorial/criteria-scoring</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>IdeaArchiveServlet</servlet-name>
        <servlet-class>controller.editorial.IdeaArchiveServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>IdeaArchiveServlet</servlet-name>
        <url-pattern>/editorial/idea-archive</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>DirectiveTopicServlet</servlet-name>
        <servlet-class>controller.editorial.DirectiveTopicServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>DirectiveTopicServlet</servlet-name>
        <url-pattern>/editorial/directive-topic</url-pattern>
        <url-pattern>/editorial/directive-creation</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ReporterDispatchServlet</servlet-name>
        <servlet-class>controller.editorial.ReporterDispatchServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ReporterDispatchServlet</servlet-name>
        <url-pattern>/editorial/reporter-dispatch</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>DeliverableReviewServlet</servlet-name>
        <servlet-class>controller.editorial.DeliverableReviewServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>DeliverableReviewServlet</servlet-name>
        <url-pattern>/editorial/deliverable-review</url-pattern>
    </servlet-mapping>

    <!-- WF-03 / WF-04: Fieldwork Servlets -->
    <servlet>
        <servlet-name>FieldworkServlet</servlet-name>
        <servlet-class>controller.FieldworkServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>FieldworkServlet</servlet-name>
        <url-pattern>/fieldwork/kanban</url-pattern>
        <url-pattern>/fieldwork/todo</url-pattern>
        <url-pattern>/fieldwork/nudge</url-pattern>
        <url-pattern>/fieldwork/audit</url-pattern>
        <url-pattern>/fieldwork/sla</url-pattern>
    </servlet-mapping>

    <!-- WF-05: Management & Governance Servlets -->
    <servlet>
        <servlet-name>UserServlet</servlet-name>
        <servlet-class>controller.UserServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>UserServlet</servlet-name>
        <url-pattern>/users</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>RbacServlet</servlet-name>
        <servlet-class>controller.RbacServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>RbacServlet</servlet-name>
        <url-pattern>/rbac</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AuditLogServlet</servlet-name>
        <servlet-class>controller.AuditLogServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AuditLogServlet</servlet-name>
        <url-pattern>/audit-log</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ReportServlet</servlet-name>
        <servlet-class>controller.ReportServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ReportServlet</servlet-name>
        <url-pattern>/report</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>QuotaServlet</servlet-name>
        <servlet-class>controller.QuotaServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>QuotaServlet</servlet-name>
        <url-pattern>/quota</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>CriteriaServlet</servlet-name>
        <servlet-class>controller.CriteriaServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>CriteriaServlet</servlet-name>
        <url-pattern>/criteria</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>CategoryServlet</servlet-name>
        <servlet-class>controller.CategoryServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>CategoryServlet</servlet-name>
        <url-pattern>/categories</url-pattern>
    </servlet-mapping>

    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>
</web-app>